<mujoco model="balance_bike">
    <compiler angle="radian" meshdir="meshes"/>
    <size njmax="500" nconmax="100"/>
    <asset>
        <mesh name="frame" file="frame.STL"/>
        <mesh name="leftwheel" file="leftwheel.STL"/>
        <mesh name="rightwheel" file="rightwheel.STL"/>
    </asset>
    <option gravity="0 0 -9.81" viscosity="0.002"/>
    <worldbody>
        <body name="golf_main" euler="0 3.14 0" pos="0 0 0.12">
            <joint name="golf_free" type="free" damping="0.5"/>

            <body name="frame">
                <inertial pos="0 0 0.0" quat="0.707107 0 0 0.707107"
                          mass="0.687" diaginertia="0.0010866 0.0016358 0.0010183"/>
                <geom type="mesh" rgba="1 0.9 0.3 1" mesh="frame"/>

                <body name="leftwheel" pos="-0.00041408 -0.08048 0.036937">
                    <inertial pos="0 0 0" quat="0.707107 0 0 0.707107"
                              mass="0.035" diaginertia="1.9757e-05 1.185e-05 1.185e-05"/>
                    <joint name="lunL" type="hinge" pos="0 0 0" axis="0 1 0" damping="0.05"/>
                    <geom type="mesh" rgba="0.05 0.05 0.05 1" mesh="leftwheel" contype="1" conaffinity="2"/>
                    <geom type="mesh" rgba="0.05 0.05 0.05 1" mesh="leftwheel"/>
                </body>

                <body name="rightwheel" pos="-0.00041408 0.08048 0.036937">
                    <inertial pos="0 0 0" quat="0.707107 0 0 0.707107" mass="0.035"
                              diaginertia="1.9757e-05 1.185e-05 1.185e-05"/>
                    <joint name="lunR" type="hinge" pos="0 0 0" axis="0 1 0" damping="0.05"/>
                    <geom type="mesh" rgba="0.05 0.05 0.05 1" mesh="rightwheel" contype="1" conaffinity="2"/>
                    <geom type="mesh" rgba="0.05 0.05 0.05 1" mesh="rightwheel"/>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor name="left_motor" joint="lunL" gear="1"/>
        <motor name="right_motor" joint="lunR" gear="1"/>
    </actuator>
</mujoco>