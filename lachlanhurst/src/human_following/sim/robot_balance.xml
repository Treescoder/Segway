<mujoco model="balance">
  <worldbody>
    <!-- ==================== 平衡车 ==================== -->
    <body name="robot_body">
      <joint name="robot_body_joint" type="free"/>
      <geom size="0.05 0.0185 0.0855" pos="0 0 0.0995" type="box"/>
      <inertial pos="0 0.0 0.057" quat="0.707107 0 0 0.707107" mass="0.514" diaginertia="0.001311 0.0012568 0.000487"/>

      <body name="l_wheel" pos="-0.074 0 0.034">
        <inertial pos="0 0 0" quat="0.5 0.5 -0.5 0.5" mass="0.032" diaginertia="2.3e-05 1.3e-05 1.3e-05"/>
        <joint name="torso_l_wheel" type="hinge" pos="0 0 0" axis="-1 0 0" damping="0.1"/>
        <geom name="l_wheel_geom" size="0.034 0.013" quat="0.707107 0 0.707107 0" type="cylinder" material="wheel_material"/>
      </body>
      <body name="r_wheel" pos="0.074 0 0.034">
        <inertial pos="0 0 0" quat="0.5 0.5 -0.5 0.5" mass="0.032" diaginertia="2.3e-05 1.3e-05 1.3e-05"/>
        <joint name="torso_r_wheel" type="hinge" pos="0 0 0" axis="1 0 0" damping="0.1"/>
        <geom name="r_wheel_geom" size="0.034 0.013" quat="0.707107 0 0.707107 0" type="cylinder" material="wheel_material"/>
      </body>
    </body>

    <!-- ==================== 行人（mocap，无关节） ==================== -->
    <body name="human" mocap="true">
      <!-- 身体：扁长方体，明显指向 -y 方向 -->
      <geom type="box" size="0.03 0.015 0.06" pos="0 0 0.065" rgba="0.9 0.2 0.2 1"/>
      <!-- 头部：小球 -->
      <geom type="sphere" size="0.035" pos="0 0 0.17" rgba="1 0.8 0.6 1"/>
    </body>
  </worldbody>

  <actuator>
    <velocity name="motor_l_wheel" joint="torso_l_wheel" gear="1" kv="0.9" ctrlrange="-200 200" ctrllimited="true"/>
    <velocity name="motor_r_wheel" joint="torso_r_wheel" gear="1" kv="0.9" ctrlrange="-200 200" ctrllimited="true"/>
  </actuator>
<!--  <actuator>-->
<!--    <motor name="motor_l_wheel" joint="torso_l_wheel" gear="0.02" ctrllimited="true" ctrlrange="-5 5"/>-->
<!--    <motor name="motor_r_wheel" joint="torso_r_wheel" gear="0.02" ctrllimited="true" ctrlrange="-5 5"/>-->
<!--  </actuator>-->
</mujoco>