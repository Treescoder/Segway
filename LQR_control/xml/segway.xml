<mujoco model="balance">
    <compiler angle="radian"/>
    <size njmax="500" nconmax="100"/>

    <asset>
        <texture type="2d" name="wheel_texture" builtin="checker" mark="edge"
                 rgb1="0.9 0.3 0.5" rgb2="0.95 0.85 0.5"
                 markrgb="0.3 0.3 0.3" width="300" height="300"/>
        <material name="wheel_material" texture="wheel_texture" texuniform="true" texrepeat="1 1"/>
    </asset>

    <option gravity="0 0 -9.81" viscosity="0.002"/>

    <worldbody>
        <body name="robot_body">
            <joint name="robot_body_joint" type="free"/>
            <geom size="0.05 0.0185 0.0855" pos="0 0 0.0995" type="box" rgba="0.9 0.3 0.5 1"/>
            <geom size="0.04" pos="0 0 0.22" type="sphere" rgba="0.9 0.3 0.5 1"/>
            <inertial pos="0 0.0 0.057" quat="0.707107 0 0 0.707107"
                      mass="0.514" diaginertia="0.001311 0.0012568 0.000487"/>

            <body name="l_wheel" pos="-0.074 0 0.034">
                <inertial pos="0 0 0" quat="0.5 0.5 -0.5 0.5" mass="0.032" diaginertia="2.3e-05 1.3e-05 1.3e-05"/>
                <joint name="torso_l_wheel" type="hinge" pos="0 0 0"
                       axis="-1 0 0"  actuatorfrcrange="-5 5" damping="0.1"/>
                <geom name="l_wheel_geom" size="0.034 0.013" quat="0.707107 0 0.707107 0"
                      type="cylinder" material="wheel_material"/>
            </body>

            <body name="r_wheel" pos="0.074 0 0.034">
                <inertial pos="0 0 0" quat="0.5 0.5 -0.5 0.5" mass="0.032" diaginertia="2.3e-05 1.3e-05 1.3e-05"/>
                <joint name="torso_r_wheel" type="hinge" pos="0 0 0"
                       axis="1 0 0"  actuatorfrcrange="-5 5" damping="0.1"/>
                <geom name="r_wheel_geom" size="0.034 0.013" quat="0.707107 0 0.707107 0"
                      type="cylinder" material="wheel_material"/>
            </body>
        </body>
    </worldbody>

    <actuator>
      <velocity name="motor_l_wheel" joint="torso_l_wheel" gear="1"/>
      <velocity name="motor_r_wheel" joint="torso_r_wheel" gear="1"/>
    </actuator>
</mujoco>
