<mujoco model="golf follow scene">
    <compiler angle="radian"/>
    <size njmax="500" nconmax="100"/>
    <!-- timestep=0.001：行人被动关节(小armature)在默认2ms步长下会数值发散，需1ms -->
    <option gravity="0 0 -9.81" viscosity="0.002" timestep="0.001"/>

    <default>
        <!-- 所有 geom 默认不参与碰撞 -->
        <geom contype="0" conaffinity="0"/>
    </default>

    <!-- ========== 引入模型模块 ========== -->
    <include file="human.xml"/>
    <include file="golf10_barfh.xml"/>

    <!-- ========== 统计 & 视觉 ========== -->
    <statistic center="0 0 0.3" extent="0.3"/>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="120" elevation="-15" fovy="50"/>
    </visual>

    <asset>
        <!-- ========== 行人材质（human.xml 依赖，从原 ebike 场景迁移） ========== -->
        <material name="mat_head" rgba="1 0.8 0.6 1"/>
        <material name="mat_handfoot" rgba="0.9 0.8 0.7 1"/>
        <material name="mat_torso" rgba="0.8 0.4 0.7 1"/>
        <material name="mat_arm" rgba="1.0 0.7 0.9 1"/>
        <material name="mat_leg" rgba="0.7 0.4 0.6 1"/>

        <!-- 天空盒 -->
        <texture type="skybox" builtin="gradient" rgb1="0.8 0.8 0.8" rgb2="0 0.3 0.5"
                 width="512" height="3072"/>
        <!-- 地面纹理 -->
        <texture type="2d" name="groundplane" builtin="checker" mark="edge"
                 rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
                 width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true"
                  texrepeat="2 2" reflectance="0.2"/>
    </asset>

    <worldbody>
        <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
        <!-- 地面：唯一接触基准（与车轮 contype=2/conaffinity=1 互配） -->
        <geom name="ground" size="0 0 0.05" type="plane" friction="1.0 1.0 0.1"
              pos="0 0 0" material="groundplane" contype="1" conaffinity="2"/>
    </worldbody>
</mujoco>
