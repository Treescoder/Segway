<mujoco model="scooter scene">
  <compiler angle="radian"/>
  <option timestep="0.000025"/>

<!--  <include file="balance.xml"/>--> # 无球包
<!--  <include file="balance_ball_and_human.xml"/> # 球包和人一起平衡-->
<!--  <include file="balance_ball_follow.xml"/> # 有球包，跟踪人平衡-->
<!--  <include file="balance_ball_buy_model.xml"/> # 买的车模型，有球包，不跟踪人仅平衡-->
<!--  <include file="balance_ball_buy_model_liu_left.xml"/> # 买的车模型, 球包在左边，不跟踪人仅平衡-->
  <include file="balance_ball_buy_model_liu_front.xml"/> # 买的车模型(liu)，球包在前面，不跟踪人仅平衡
<!--  <include file="balance_ball_buy_model_liu_in.xml"/> # 买的车模型(liu)，球包在里面，不跟踪人仅平衡-->
<!--  <include file="balance_ball_follow_buy_model.xml"/> # 买的车模型，有球包，跟踪人且平衡-->



  <statistic center="0 0 0.3" extent="0.3"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-15" fovy="50"/>
  </visual>

  <asset>
    <!-- 天空盒：golf scene 的灰色渐变 -->
    <texture type="skybox" builtin="gradient" rgb1="0.8 0.8 0.8" rgb2="0 0 0" width="512" height="3072"/>
    <!-- 地面纹理：golf scene 的深色棋盘格 -->
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <!-- 地面几何体 -->
    <geom name="ground" size="0 0 0.05" type="plane" friction="1.0 1.0 0.1"
          pos="0 0 0" material="groundplane" contype="1" conaffinity="2"/>
  </worldbody>
</mujoco>